

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UrlStatus {
  ACTIVE
  EXPIRED
}


model ShortUrl {
  id        String    @id @default(cuid())
  code      String    @unique
  longUrl   String
  userId    String?
  clicks    Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  alias     String?
  status    UrlStatus @default(ACTIVE)
}

model ConversionLog {
  id            String   @id @default(cuid())
  originalName  String 
  originalPath  String 
  convertedPath String?
  type          String 
  category      Category @default(DOCUMENT)
  fileSize      Int
  status        Status   @default(PENDING)
  durationMs    Int?
  error         String?
  userId        String?
  createdAt     DateTime @default(now())
}

enum Category {
  IMAGE
  DOCUMENT
  PDF_MERGE
}

enum Status {
  PENDING
  COMPLETED
  FAILED
}

